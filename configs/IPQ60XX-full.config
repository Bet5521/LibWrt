# ============================================================
#  京东云 AX1800 Pro 亚瑟（jdcloud_re-ss-01）—— 全功能满血 NSS
#  在基准档基础上追加常用 LuCI 应用 / 命令行工具 / USB 存储支持。
#  由 configs/_gen_profiles.py 从 IPQ60XX.config 自动派生，勿手工改
# ============================================================

CONFIG_TARGET_qualcommax=y
CONFIG_TARGET_qualcommax_ipq60xx=y
CONFIG_TARGET_MULTI_PROFILE=y
CONFIG_TARGET_DEVICE_qualcommax_ipq60xx_DEVICE_jdcloud_re-ss-01=y
CONFIG_TARGET_ARCH_PACKAGES="aarch64_cortex-a53"
CONFIG_TARGET_BOARD="qualcommax"
CONFIG_TARGET_SUBTARGET="ipq60xx"
CONFIG_TARGET_ROOTFS_SQUASHFS=y
CONFIG_TARGET_ROOTFS_EXT4FS=n
CONFIG_TARGET_KERNEL_PARTSIZE=12
CONFIG_TARGET_ROOTFS_PARTSIZE=2048
# 已删除 CONFIG_TARGET_ROOTFS_UBI：本机是 eMMC（mmcblk0p18），本分支也没有 UBI 根文件系统选项。
# 已删除 CONFIG_TARGET_IMAGES_GZIP：它依赖 EXT4FS，而这里 EXT4FS=n，写了也不会生效
#   （原文件还把它重复写了两次，属于冗余）。

# ---------- 内核 ----------
CONFIG_KERNEL_KALLSYMS=y
CONFIG_KERNEL_DEBUG_FS=y
CONFIG_KERNEL_PROFILING=y
# 已删除（本分支源码树里不存在，defconfig 会静默丢弃，等于没写）：
#   CONFIG_KERNEL_KALLSYMS_UNCOMPRESSED / CONFIG_KERNEL_XTAX / CONFIG_KERNEL_MODULE_UNLOAD_TAINT_TRACKING

# ---------- NSS 满血卸载 ----------
CONFIG_PACKAGE_kmod-qca-nss-drv=y
CONFIG_PACKAGE_kmod-qca-nss-ecm=y
CONFIG_PACKAGE_kmod-qca-nss-crypto=y
CONFIG_PACKAGE_kmod-qca-nss-dp=y
# NSS 固件：IPQ60xx 专用包（来自 qosmio/nss-packages 的 firmware/nss-firmware）
CONFIG_PACKAGE_nss-firmware-ipq60xx=y
# NSS 固件版本：源码树里【没有】NSS_FIRMWARE_VERSION_12_5 这个符号。
#   - 12.5 是 nss_packages feed 默认分支（NSS-12.5-K6.x）自带的，不需要也不会被 config 选中；
#   - NSS_FIRMWARE_VERSION_11_4 是隐藏的辅助符号，仅由 ATH11K_NSS_MESH_SUPPORT(WDS/MESH 卸载)
#     select 出来，同时会给 ath11k 打 fw-11.4 检查补丁。
#   家用场景（不跑 WDS/MESH）保持默认 12.5 即可，因此这里两行都不写。
# CONFIG_NSS_FIRMWARE_VERSION_11_4 is not set
# 已删除 CONFIG_ECM_INTERFACE_{BOND,BRIDGE,GRE_TAP,GRE_TUN,PPPOE,VLAN}：
#   qosmio 的 nss-ecm 不提供这些 Kconfig 选项，写了等于没写，ECM 前端走默认即可。

# ---------- 无线 ath11k（QCN5022 2.4G + QCN5052 5G）----------
CONFIG_PACKAGE_kmod-ath11k=y
CONFIG_PACKAGE_kmod-ath11k-ahb=y
CONFIG_PACKAGE_kmod-ath11k-pci=y
# ath11k-firmware 的子包是 ipq5018 / ipq5018-qcn6122 / ipq6018 / ipq8074 / qca2066 / qca6390，
# 并【没有】叫 default 的子包 —— 所以 ath11k-firmware-default 是无效符号，已删除。
# IPQ60xx 必须选 ipq6018（QCN5052/QCN5022 闭源固件在这一组里）
CONFIG_PACKAGE_ath11k-firmware-ipq6018=y
# board-2.bin 覆盖件由 DEVICE_PACKAGES=ipq-wifi-jdcloud_re-ss-01 自动带出，无需手写
# wpad-* 把 hostapd/wpa-supplicant 合并成一个，不要同时选 hostapd 和 wpa-supplicant
CONFIG_PACKAGE_wpad-basic-mbedtls=y
# 无线页面「信道」下拉依赖 iwinfo 枚举可用信道；wireless-regdb 提供国家码信道表（否则 5G 可选信道被锁死）
CONFIG_PACKAGE_iwinfo=y
CONFIG_PACKAGE_libiwinfo-ucode=y
CONFIG_PACKAGE_wireless-regdb=y
CONFIG_PACKAGE_kmod-mt76=n
# 已删除 CONFIG_WPA_MBEDTLS_CRYPTO / CONFIG_WPA_11KV_SUPPORT / CONFIG_WPA_11R_SUPPORT：
#   本分支的 hostapd 没有这三个选项，802.11r/k/v 不由它们控制，写了等于没写。

# ---------- 网络基础 ----------
# 上网三件套（缺一即「能进 LuCI 但上不了网」，不要动）：
#   firewall4 + nftables-json + kmod-ipt-nat
CONFIG_PACKAGE_dnsmasq-full=y
CONFIG_PACKAGE_odhcp6c=y
CONFIG_PACKAGE_odhcpd-ipv6only=y
CONFIG_PACKAGE_firewall4=y
CONFIG_PACKAGE_kmod-nft-offload=y
CONFIG_PACKAGE_nftables-json=y
CONFIG_PACKAGE_kmod-ipt-offload=y
CONFIG_PACKAGE_kmod-ipt-nat=y
CONFIG_PACKAGE_kmod-ipt-conntrack=y
CONFIG_PACKAGE_kmod-pppoe=y
CONFIG_PACKAGE_kmod-pppox=y
CONFIG_PACKAGE_kmod-gre=y
CONFIG_PACKAGE_kmod-ipip=y
CONFIG_PACKAGE_kmod-vxlan=y
CONFIG_PACKAGE_kmod-crypto-xts=y
CONFIG_PACKAGE_kmod-crypto-cbc=y
CONFIG_PACKAGE_kmod-sched-cake=y
# NSS 版 SQM（来自 sqm_scripts_nss feed）
CONFIG_PACKAGE_sqm-scripts-nss=y
CONFIG_PACKAGE_luci-app-sqm=y
CONFIG_PACKAGE_luci-app-upnp=y
CONFIG_PACKAGE_luci-app-wol=y
CONFIG_PACKAGE_luci-app-firewall=y
CONFIG_PACKAGE_luci-app-package-manager=y
CONFIG_PACKAGE_luci-app-turboacc=n
# 已删除（本分支不存在，写了等于没写）：
#   kmod-tunnel4 / kmod-crypto-aes / kmod-crypto-sha2 / kmod-sqm
#   （存在的是 kmod-crypto-sha256 / kmod-crypto-sha512 之类）

# ---------- LuCI（极简，够用就好）----------
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-base=y
CONFIG_PACKAGE_luci-mod-admin-full=y
CONFIG_PACKAGE_luci-mod-network=y
CONFIG_PACKAGE_luci-mod-status=y
CONFIG_PACKAGE_luci-mod-system=y
CONFIG_PACKAGE_luci-proto-ipv6=y
CONFIG_PACKAGE_luci-proto-ppp=y
CONFIG_PACKAGE_luci-theme-bootstrap=y
# 额外主题：可在「系统 → 系统 → 语言与界面」里切换
CONFIG_PACKAGE_luci-theme-openwrt-2020=y
CONFIG_PACKAGE_luci-theme-material=y
CONFIG_PACKAGE_luci-theme-argon=y
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y
CONFIG_PACKAGE_luci-i18n-firewall-zh-cn=y
CONFIG_PACKAGE_luci-i18n-package-manager-zh-cn=y
CONFIG_PACKAGE_luci-i18n-upnp-zh-cn=y
CONFIG_PACKAGE_luci-i18n-sqm-zh-cn=y

# ---------- 基础工具 ----------
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_ca-certificates=y
CONFIG_PACKAGE_openssh-server=y
CONFIG_PACKAGE_openssh-client-utils=y
CONFIG_PACKAGE_htop=y
CONFIG_PACKAGE_ttyd=y
CONFIG_PACKAGE_coreutils=y
CONFIG_PACKAGE_coreutils-sort=y
CONFIG_PACKAGE_logrotate=y
CONFIG_PACKAGE_terminfo=y
CONFIG_PACKAGE_libustream-mbedtls=y
CONFIG_PACKAGE_ucode=y
CONFIG_PACKAGE_ucode-mod-fs=y
CONFIG_PACKAGE_ucode-mod-uci=y
CONFIG_PACKAGE_ucode-mod-ubus=y
CONFIG_PACKAGE_xz=y
CONFIG_PACKAGE_zstd=y
# 已删除 watchdog / coreutils-xxd：本分支没有这两个包。

# ---------- 精简：明确不要 ----------
CONFIG_PACKAGE_docker=n
CONFIG_PACKAGE_luci-app-dockerman=n
CONFIG_PACKAGE_luci-app-passwall=n
CONFIG_PACKAGE_luci-app-openclash=n
CONFIG_PACKAGE_luci-app-adguardhome=n
CONFIG_PACKAGE_luci-app-qbittorrent=n
CONFIG_PACKAGE_luci-app-samba4=n
CONFIG_PACKAGE_samba4-server=n
CONFIG_PACKAGE_transmission-daemon=n
CONFIG_PACKAGE_luci-app-aria2=n
CONFIG_PACKAGE_luci-app-zerotier=n
CONFIG_PACKAGE_luci-app-frps=n
CONFIG_PACKAGE_luci-app-frpc=n
# 已删除 luci-app-filetransfer=n：本分支 luci 源里没有这个包，写 =n 无意义。

# ---------- 镜像 / 编译加速 ----------
# CONFIG_CCACHE 在 config/Config-devel.in 里是 `bool "Use ccache" if DEVEL`。
# 不先开 DEVEL 的话这一行会被 kconfig 静默丢掉，ccache 等于没启用
# （.ccache 目录永远是空的）→ 所以 CONFIG_DEVEL=y 必须写在它前面。
CONFIG_DEVEL=y
CONFIG_CCACHE=y

# ============================================================
#  以下为「全功能档」追加内容（基准档没有）
#  若某个包在本分支不存在，Apply Config 步骤会自动剔除并打印 [drop]，
#  不会导致编译失败。
# ============================================================

# ---------- 常用 LuCI 应用 ----------
CONFIG_PACKAGE_luci-app-commands=y
CONFIG_PACKAGE_luci-app-ddns=y
CONFIG_PACKAGE_luci-app-uhttpd=y
CONFIG_PACKAGE_luci-app-nlbwmon=y
CONFIG_PACKAGE_luci-app-watchcat=y
CONFIG_PACKAGE_luci-app-autoreboot=y
CONFIG_PACKAGE_luci-app-arpbind=y
CONFIG_PACKAGE_luci-app-vlmcsd=y
CONFIG_PACKAGE_luci-app-smartdns=y
CONFIG_PACKAGE_luci-app-ttyd=y
CONFIG_PACKAGE_luci-app-hd-idle=y
CONFIG_PACKAGE_luci-app-diskman=y
CONFIG_PACKAGE_luci-app-netdata=y
CONFIG_PACKAGE_luci-app-openvpn=y
CONFIG_PACKAGE_luci-app-wifischedule=y

# ---------- 中文界面 ----------
CONFIG_PACKAGE_luci-i18n-commands-zh-cn=y
CONFIG_PACKAGE_luci-i18n-ddns-zh-cn=y
CONFIG_PACKAGE_luci-i18n-uhttpd-zh-cn=y
CONFIG_PACKAGE_luci-i18n-nlbwmon-zh-cn=y
CONFIG_PACKAGE_luci-i18n-watchcat-zh-cn=y
CONFIG_PACKAGE_luci-i18n-autoreboot-zh-cn=y
CONFIG_PACKAGE_luci-i18n-arpbind-zh-cn=y
CONFIG_PACKAGE_luci-i18n-vlmcsd-zh-cn=y
CONFIG_PACKAGE_luci-i18n-smartdns-zh-cn=y
CONFIG_PACKAGE_luci-i18n-ttyd-zh-cn=y
CONFIG_PACKAGE_luci-i18n-hd-idle-zh-cn=y
CONFIG_PACKAGE_luci-i18n-diskman-zh-cn=y
CONFIG_PACKAGE_luci-i18n-netdata-zh-cn=y
CONFIG_PACKAGE_luci-i18n-openvpn-zh-cn=y
CONFIG_PACKAGE_luci-i18n-wifischedule-zh-cn=y

# ---------- 命令行工具 ----------
CONFIG_PACKAGE_bash=y
CONFIG_PACKAGE_nano=y
CONFIG_PACKAGE_tmux=y
CONFIG_PACKAGE_iperf3=y
CONFIG_PACKAGE_mtr-json=y
CONFIG_PACKAGE_tcpdump=y
CONFIG_PACKAGE_openssl-util=y

# ---------- USB 存储 / 挂载 ----------
CONFIG_PACKAGE_kmod-usb3=y
CONFIG_PACKAGE_kmod-usb-storage=y
CONFIG_PACKAGE_kmod-usb-storage-uas=y
CONFIG_PACKAGE_block-mount=y
CONFIG_PACKAGE_kmod-fs-ext4=y
CONFIG_PACKAGE_kmod-fs-exfat=y
CONFIG_PACKAGE_kmod-fs-ntfs3=y
CONFIG_PACKAGE_e2fsprogs=y

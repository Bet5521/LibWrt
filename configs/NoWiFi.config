# ============================================================
#  京东云 AX1800 Pro 亚瑟（jdcloud_re-ss-01）—— 无无线满血 NSS
#  纯有线路由 / 旁路由：不编 ath11k 与 wpad，体积更小、启动更干净。
#  由 configs/_gen_profiles.py 从 IPQ60XX.config 自动派生，勿手工改
# ============================================================

CONFIG_TARGET_qualcommax=y
CONFIG_TARGET_qualcommax_ipq60xx=y
CONFIG_TARGET_MULTI_PROFILE=y
CONFIG_TARGET_DEVICE_qualcommax_ipq60xx_DEVICE_jdcloud_re-ss-01=y
CONFIG_TARGET_ARCH_PACKAGES="aarch64_cortex-a53"
CONFIG_TARGET_BOARD="qualcommax"
CONFIG_TARGET_SUBTARGET="ipq60xx"
CONFIG_TARGET_ROOTFS_SQUASHFS=y
CONFIG_TARGET_ROOTFS_UBI=y
CONFIG_TARGET_ROOTFS_EXT4FS=n
CONFIG_TARGET_IMAGES_GZIP=y
CONFIG_TARGET_KERNEL_PARTSIZE=12
CONFIG_TARGET_ROOTFS_PARTSIZE=2048

# ---------- 内核 ----------
CONFIG_KERNEL_KALLSYMS=y
CONFIG_KERNEL_KALLSYMS_UNCOMPRESSED=y
CONFIG_KERNEL_XTAX=y
CONFIG_KERNEL_DEBUG_FS=y
CONFIG_KERNEL_MODULE_UNLOAD_TAINT_TRACKING=y
CONFIG_KERNEL_PROFILING=y

# ---------- NSS 满血卸载 ----------
CONFIG_PACKAGE_kmod-qca-nss-drv=y
CONFIG_PACKAGE_kmod-qca-nss-ecm=y
CONFIG_PACKAGE_kmod-qca-nss-crypto=y
CONFIG_PACKAGE_kmod-qca-nss-dp=y
# NSS 固件：IPQ60xx 专用包（来自 qosmio/nss-packages 的 firmware/nss-firmware）
CONFIG_PACKAGE_nss-firmware-ipq60xx=y
# NSS 固件版本：源码树里【没有】NSS_FIRMWARE_VERSION_12_5 这个符号。
#   - 12.5 是 nss_packages feed 默认分支（NSS-12.5-K6.x）自带的，不需要也不会被 config 选中；
#   - NSS_FIRMWARE_VERSION_11_4 是隐藏的辅助符号，仅由 ATH11K_NSS_MESH_SUPPORT(WDS/MESH 卸载)
#     select 出来，同时会给 ath11k 打 fw-11.4 检查补丁。
#   家用场景（不跑 WDS/MESH）保持默认 12.5 即可，因此这里两行都不写。
# CONFIG_NSS_FIRMWARE_VERSION_11_4 is not set
# ECM 前端：走 NSS 的连接管理
CONFIG_ECM_INTERFACE_BOND=y
CONFIG_ECM_INTERFACE_BRIDGE=y
CONFIG_ECM_INTERFACE_GRE_TAP=y
CONFIG_ECM_INTERFACE_GRE_TUN=y
CONFIG_ECM_INTERFACE_PPPOE=y
CONFIG_ECM_INTERFACE_VLAN=y

# ---------- 无线 ath11k（QCN5022 2.4G + QCN5052 5G）----------
# [移除] CONFIG_PACKAGE_kmod-ath11k=y
# [移除] CONFIG_PACKAGE_kmod-ath11k-ahb=y
# [移除] CONFIG_PACKAGE_kmod-ath11k-pci=y
# 25.12 的 ath11k-firmware 子包只有 default/ipq5018/ipq5018-qcn6122/ipq6018/ipq8074/qcn9074
# IPQ60xx 必须选 ipq6018（QCN5052/QCN5022 闭源固件在这一组里）
# [移除] CONFIG_PACKAGE_ath11k-firmware-ipq6018=y
# [移除] CONFIG_PACKAGE_ath11k-firmware-default=y
# board-2.bin 覆盖件由 DEVICE_PACKAGES=ipq-wifi-jdcloud_re-ss-01 自动带出，无需手写
# wpad-* 把 hostapd/wpa-supplicant 合并成一个，不要同时选 hostapd 和 wpa-supplicant
# [移除] CONFIG_PACKAGE_wpad-basic-mbedtls=y
CONFIG_PACKAGE_kmod-mt76=n
# [移除] CONFIG_WPA_MBEDTLS_CRYPTO=y
# [移除] CONFIG_WPA_11KV_SUPPORT=y
# [移除] CONFIG_WPA_11R_SUPPORT=y

# ---------- 网络基础 ----------
CONFIG_PACKAGE_dnsmasq-full=y
CONFIG_PACKAGE_odhcp6c=y
CONFIG_PACKAGE_odhcpd-ipv6only=y
CONFIG_PACKAGE_firewall4=y
CONFIG_PACKAGE_kmod-nft-offload=y
CONFIG_PACKAGE_nftables-json=y
CONFIG_PACKAGE_kmod-ipt-offload=y
CONFIG_PACKAGE_kmod-ipt-nat=y
CONFIG_PACKAGE_kmod-ipt-conntrack=y
CONFIG_PACKAGE_kmod-pppoe=y
CONFIG_PACKAGE_kmod-pppox=y
CONFIG_PACKAGE_kmod-gre=y
CONFIG_PACKAGE_kmod-ipip=y
CONFIG_PACKAGE_kmod-vxlan=y
CONFIG_PACKAGE_kmod-tunnel4=y
CONFIG_PACKAGE_kmod-crypto-xts=y
CONFIG_PACKAGE_kmod-crypto-aes=y
CONFIG_PACKAGE_kmod-crypto-sha2=y
CONFIG_PACKAGE_kmod-crypto-cbc=y
CONFIG_PACKAGE_kmod-sched-cake=y
CONFIG_PACKAGE_kmod-sqm=y
# NSS 版 SQM（来自 sqm_scripts_nss feed）
CONFIG_PACKAGE_sqm-scripts-nss=y
CONFIG_PACKAGE_luci-app-sqm=y
CONFIG_PACKAGE_luci-app-upnp=y
CONFIG_PACKAGE_luci-app-wol=y
CONFIG_PACKAGE_luci-app-firewall=y
CONFIG_PACKAGE_luci-app-package-manager=y
CONFIG_PACKAGE_luci-app-turboacc=n

# ---------- LuCI（极简，够用就好）----------
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-base=y
CONFIG_PACKAGE_luci-mod-admin-full=y
CONFIG_PACKAGE_luci-mod-network=y
CONFIG_PACKAGE_luci-mod-status=y
CONFIG_PACKAGE_luci-mod-system=y
CONFIG_PACKAGE_luci-proto-ipv6=y
CONFIG_PACKAGE_luci-proto-ppp=y
CONFIG_PACKAGE_luci-theme-bootstrap=y
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y
CONFIG_PACKAGE_luci-i18n-firewall-zh-cn=y
CONFIG_PACKAGE_luci-i18n-package-manager-zh-cn=y
CONFIG_PACKAGE_luci-i18n-upnp-zh-cn=y
CONFIG_PACKAGE_luci-i18n-sqm-zh-cn=y

# ---------- 基础工具 ----------
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_ca-certificates=y
CONFIG_PACKAGE_openssh-server=y
CONFIG_PACKAGE_openssh-client-utils=y
CONFIG_PACKAGE_htop=y
CONFIG_PACKAGE_ttyd=y
CONFIG_PACKAGE_watchdog=y
CONFIG_PACKAGE_coreutils=y
CONFIG_PACKAGE_coreutils-sort=y
CONFIG_PACKAGE_coreutils-xxd=y
CONFIG_PACKAGE_logrotate=y
CONFIG_PACKAGE_terminfo=y
CONFIG_PACKAGE_libustream-mbedtls=y
CONFIG_PACKAGE_ucode=y
CONFIG_PACKAGE_ucode-mod-fs=y
CONFIG_PACKAGE_ucode-mod-uci=y
CONFIG_PACKAGE_ucode-mod-ubus=y
CONFIG_PACKAGE_xz=y
CONFIG_PACKAGE_zstd=y

# ---------- 精简：明确不要 ----------
CONFIG_PACKAGE_docker=n
CONFIG_PACKAGE_luci-app-dockerman=n
CONFIG_PACKAGE_luci-app-passwall=n
CONFIG_PACKAGE_luci-app-openclash=n
CONFIG_PACKAGE_luci-app-adguardhome=n
CONFIG_PACKAGE_luci-app-qbittorrent=n
CONFIG_PACKAGE_luci-app-samba4=n
CONFIG_PACKAGE_samba4-server=n
CONFIG_PACKAGE_transmission-daemon=n
CONFIG_PACKAGE_luci-app-filetransfer=n
CONFIG_PACKAGE_luci-app-aria2=n
CONFIG_PACKAGE_luci-app-zerotier=n
CONFIG_PACKAGE_luci-app-frps=n
CONFIG_PACKAGE_luci-app-frpc=n

# ---------- 镜像 / 体积 ----------
CONFIG_TARGET_IMAGES_GZIP=y
CONFIG_CCACHE=y

# ---------- 显式关掉一切无线相关（核心差异）----------
# 这些包在基准档里没出现，但写 =n 能防止被其它依赖悄悄拉回来。
CONFIG_PACKAGE_kmod-ath11k=n
CONFIG_PACKAGE_kmod-ath11k-ahb=n
CONFIG_PACKAGE_kmod-ath11k-pci=n
CONFIG_PACKAGE_ath11k-firmware-ipq6018=n
CONFIG_PACKAGE_ath11k-firmware-default=n
CONFIG_PACKAGE_wpad-basic-mbedtls=n
CONFIG_PACKAGE_wpad-basic-openssl=n
CONFIG_PACKAGE_wpad-openssl=n
CONFIG_PACKAGE_hostapd=n
CONFIG_PACKAGE_wpa-supplicant=n
CONFIG_PACKAGE_iw=n
CONFIG_PACKAGE_iwinfo=n
CONFIG_PACKAGE_luci-app-wifischedule=n

# WPA 相关开关在无无线档下没有意义，一并关掉
# CONFIG_WPA_MBEDTLS_CRYPTO is not set
# CONFIG_WPA_11KV_SUPPORT is not set
# CONFIG_WPA_11R_SUPPORT is not set
